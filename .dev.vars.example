# ── Telegram ────────────────────────────────────────────────────────────────
# REQUIRED. Get it from @BotFather. Never commit the real value.
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Random string used to verify Telegram's X-Telegram-Bot-Api-Secret-Token header.
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=change-me-random-64-hex

# HMAC secret for signing /dl/ inline-audio proxy links.
LINK_SECRET=change-me-random-64-hex

# Guards the GET /setup bootstrap route.
ADMIN_SETUP_KEY=change-me-random-32-hex

# ── Optional overrides ──────────────────────────────────────────────────────
# Override Telegram API base (used by the e2e test to intercept calls).
# TELEGRAM_API_BASE=http://127.0.0.1:8787/tg
# Override the deployed public URL (used by /setup + signed links).
# PUBLIC_URL=https://music-bot.your-subdomain.workers.dev
# Optional Shazam ffmpeg backend for video/OGG recognition (see README §limits).
# SHAZAM_BACKEND_URL=
# SHAZAM_BACKEND_KEY=
# Optional API key for the insta-worker if you secured it.
# INSTA_API_KEY=
