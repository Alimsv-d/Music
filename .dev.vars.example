# ── Telegram ────────────────────────────────────────────────────────────────
# REQUIRED. Get it from @BotFather. Never commit the real value.
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bot username is resolved automatically from Telegram getMe; this optional
# value is only for local UI previews.
# BOT_USERNAME=SearcherMusiic_Bot

# REQUIRED. Your numeric Telegram id (send /start to @userinfobot to see it).
# Used for admin rights and to auto-derive WEBHOOK_SECRET / LINK_SECRET /
# ADMIN_SETUP_KEY — with just these two values the bot fully activates itself.
OWNER_ID=8437014959

# OPTIONAL — leave unset to auto-derive each from BOT_TOKEN+OWNER_ID (same
# derivation the Deploy Button relies on). Set explicit values only if you
# need to rotate them independently.
# WEBHOOK_SECRET=
# LINK_SECRET=
# ADMIN_SETUP_KEY=

# ── Optional overrides ──────────────────────────────────────────────────────
# Override Telegram API base (used by the e2e test to intercept calls).
# TELEGRAM_API_BASE=http://127.0.0.1:8787/tg
# Override the deployed public URL (used by /setup + signed links).
# PUBLIC_URL=https://music-bot.your-subdomain.workers.dev
# Optional Shazam ffmpeg backend for video/OGG recognition (see README §limits).
# SHAZAM_BACKEND_URL=
# SHAZAM_BACKEND_KEY=
# Optional API key for the insta-worker if you secured it.
# INSTA_API_KEY=
