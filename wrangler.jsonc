{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "music-bot",
  "main": "src/index.js",

  // The eshaz wasm-decoder packages import their WebWorker wrapper at module
  // load; the real @eshaz/web-worker evaluates `Worker` globally and the
  // Workers runtime has none (deploy error 10021). The stub keeps the module
  // loadable; our decoders never spawn workers (inline WASM main-thread).
  "alias": {
    "@eshaz/web-worker": "./src/stubs/web-worker.js"
  },
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },

  // KV namespace. `id` is intentionally omitted: Wrangler (>= 4.45) auto-
  // provisions a namespace on `wrangler deploy` and writes the generated id
  // back here. For `wrangler dev`, a local preview namespace is used
  // automatically. The GitHub Action also can inject an explicit id if needed.
  "kv_namespaces": [
    { "binding": "KV" }
  ],

  // Cron: keep webhook healthy + process broadcast jobs.
  "triggers": {
    "crons": ["*/5 * * * *", "* * * * *"]
  },

  "vars": {
    // Public, non-secret configuration. BOT_TOKEN / OWNER_ID are NOT here:
    // they are captured at Deploy-to-Cloudflare time (from .dev.vars.example)
    // or uploaded as Worker secrets in CI — see README §Deploy.
    "OWNER_USERNAME": "AliMsvD",
    "CREATOR_NAME": "Ali Mousavi",
    "BOT_NAME": "Music",

    // Service base URLs are intentionally empty: when unset, the adapters
    // self-route to THIS worker's bundled /svc/* services (src/ctx.js),
    // so every deployment is fully independent. Point them at a dedicated
    // backend URL only if you want to offload heavy work.
    "LRCLIB_API_URL": "https://lrclib.net",

    // Behaviour defaults (can be overridden live from the owner panel; those
    // writes land in KV under cfg:* and take precedence over these vars).
    "DEFAULT_LANG": "fa",
    "PAGE_SIZE": "10",
    "MAX_UPLOAD_MB": "50",
    "TELEGRAM_FILE_LIMIT_MB": "20",
    "RATE_LIMIT_PER_MIN": "20",
    "RATE_LIMIT_HEAVY_PER_MIN": "5",
    "SEARCH_CACHE_TTL": "300",
    "TRACK_CACHE_TTL": "3600",
    "RESULT_TTL": "3600",
    "API_TIMEOUT_MS": "10000"
  }
}
