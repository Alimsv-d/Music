{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "music-bot",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "PUBLIC_URL": ""
  },
  "kv_namespaces": [
    { "binding": "KV" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "music_bot_db" }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
